flowchart LR
  usuarios["<b>Enfermeras</b><br/><i>Web · Electron</i>"]
  entra["<b>Entra ID</b><br/><i>Seguridad corporativa</i>"]
  afd["<b>Front Door + WAF</b><br/><i>Balanceo y failover</i>"]

  subgraph primaria["Región principal · East US 2 · ACTIVA · 3 zonas"]
    direction LR
    apim1["<b>API Management</b>"]
    aks1["<b>AKS</b><br/><i>5 microservicios<br/>3 a 12 nodos</i>"]
    pg1[("<b>PostgreSQL</b><br/><i>Alta disponibilidad</i>")]
    datos1["<b>Redis · Service Bus<br/>Blob · Key Vault</b><br/><i>Red privada</i>"]
    salud["<b>FHIR · OpenAI</b><br/><i>Red privada</i>"]
  end

  subgraph secundaria["Región de respaldo · Central US · PASIVA"]
    direction LR
    apim2["<b>API Management</b>"]
    aks2["<b>AKS</b><br/><i>2 nodos en espera</i>"]
    pg2[("<b>PostgreSQL</b><br/><i>Réplica de la principal</i>")]
  end

  compartidos["<b>Servicios compartidos</b><br/><i>Azure Maps · Comunicaciones<br/>Monitor · Defender · Registry</i>"]

  usuarios -- "Login" --> entra
  usuarios -- "HTTPS" --> afd
  afd == "Tráfico" ==> apim1
  afd -. "Si falla" .-> apim2
  apim1 --> aks1
  aks1 --> pg1
  aks1 --> datos1
  aks1 --> salud
  apim2 --> aks2 --> pg2
  aks1 --> compartidos

  classDef az fill:#0078d4,stroke:#005a9e,color:#ffffff,font-size:20px
  classDef datos fill:#50a0e6,stroke:#2b6fa8,color:#ffffff,font-size:20px
  classDef pasivo fill:#b4c9dc,stroke:#6f8fae,color:#000000,font-size:20px
  classDef usuario fill:#08427b,stroke:#052e56,color:#ffffff,font-size:20px
  classDef sec fill:#107c10,stroke:#0b5a0b,color:#ffffff,font-size:20px
  class usuarios usuario
  class afd,apim1,aks1,salud,compartidos az
  class pg1,datos1 datos
  class entra sec
  class apim2,aks2,pg2 pasivo
  style primaria fill:#eef6ee,stroke:#107c10,stroke-width:2px
  style secundaria fill:#f5f5f5,stroke:#888888,stroke-width:2px,stroke-dasharray:6 4
