---
title: Diagrama de Contexto - Plataforma de Atención de Enfermería Medical Health
---
flowchart TB
  paciente["<b>Paciente</b><br/><i>[Persona]</i><br/>Llama al centro de llamadas con dudas<br/>sobre su salud. En la fase 2 usará<br/>la aplicación directamente."]
  enfermera["<b>Enfermera</b><br/><i>[Persona]</i><br/>Atiende las llamadas de los pacientes.<br/>250 o más usuarias concurrentes."]
  supervisora["<b>Supervisora</b><br/><i>[Persona]</i><br/>Supervisa casos, turnos e<br/>indicadores del centro de llamadas."]

  plataforma["<b>Plataforma de Atención de Enfermería</b><br/><i>[Sistema de software]</i><br/>Consulta historias clínicas, asiste el diagnóstico,<br/>ubica centros médicos y gestiona remisiones."]

  idp["<b>Sistema de Seguridad Centralizado</b><br/><i>[Sistema externo]</i><br/>Proveedor de identidad corporativo<br/>OpenID Connect / OAuth 2.0"]
  hce["<b>Sistema de Historias Clínicas</b><br/><i>[Sistema externo]</i><br/>Historias clínicas del hospital<br/>expuestas en HL7 FHIR"]
  motor["<b>Motor de Apoyo al Diagnóstico</b><br/><i>[Sistema externo]</i><br/>Modelo de lenguaje gestionado<br/>para sugerencias clínicas"]
  mapas["<b>Servicio de Mapas</b><br/><i>[Sistema externo]</i><br/>Geocodificación, distancias y rutas"]
  comunicaciones["<b>Servicio de Comunicaciones</b><br/><i>[Sistema externo]</i><br/>Llamadas, SMS y correo electrónico"]
  centros["<b>Centros Médicos de la Red</b><br/><i>[Sistema externo]</i><br/>Clínicas y hospitales que reciben<br/>a los pacientes remitidos"]

  paciente -- "Llama y describe<br/>sus síntomas" --> enfermera
  paciente -. "Fase 2: usa la app<br/>[HTTPS]" .-> plataforma
  enfermera -- "Consulta y registra la atención<br/>[HTTPS]" --> plataforma
  supervisora -- "Monitorea casos e indicadores<br/>[HTTPS]" --> plataforma
  plataforma -- "Autentica y autoriza<br/>[OIDC]" --> idp
  plataforma -- "Lee historias clínicas<br/>[FHIR / HTTPS]" --> hce
  plataforma -- "Solicita sugerencias<br/>[HTTPS]" --> motor
  plataforma -- "Busca centros cercanos<br/>[HTTPS]" --> mapas
  plataforma -- "Envía avisos de remisión<br/>[HTTPS]" --> comunicaciones
  comunicaciones -- "Notifica llegada del paciente<br/>[Voz / SMS / Email]" --> centros

  classDef persona fill:#08427b,stroke:#052e56,color:#ffffff
