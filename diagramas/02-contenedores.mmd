---
title: Diagrama de Contenedores
---
flowchart LR
  usuario["<b>Enfermera /<br/>Supervisora</b>"]
  subgraph plataforma["Plataforma de Atención de Enfermería"]
    direction LR
    web["<b>App Web</b><br/><i>React</i>"]
    desktop["<b>App Escritorio</b><br/><i>Electron</i>"]
    gateway["<b>API Gateway</b><br/><i>API Management</i>"]
    historia["<b>Historia Clínica</b><br/><i>HU01 · NestJS</i>"]
    diagnostico["<b>Diagnóstico</b><br/><i>HU02 · FastAPI</i>"]
    centros["<b>Centros Médicos</b><br/><i>HU03 · NestJS</i>"]
    remision["<b>Remisión</b><br/><i>HU04 · NestJS</i>"]
    casos["<b>Llamadas y Casos</b><br/><i>NestJS</i>"]
    fhir[("<b>Repositorio FHIR</b>")]
    dbCentros[("<b>BD Centros</b><br/><i>PostGIS</i>")]
    bus[["<b>Service Bus</b>"]]
    dbCasos[("<b>BD Casos</b><br/><i>PostgreSQL</i>")]
  end
  idp["<b>Seguridad<br/>Centralizada</b>"]
  motor["<b>Azure OpenAI</b>"]
  mapas["<b>Azure Maps</b>"]
  acs["<b>Comunicaciones</b>"]

  usuario --> web & desktop
  web & desktop -- "Login OIDC" --> idp
  web & desktop -- "HTTPS + JWT" --> gateway
  gateway --> historia & diagnostico & centros & remision & casos
  historia --> fhir
  diagnostico --> motor
  centros --> dbCentros
  centros --> mapas
  remision --> bus
  remision --> acs
  casos --> dbCasos

  classDef persona fill:#08427b,stroke:#052e56,color:#ffffff,font-size:20px
  classDef sistema fill:#1168bd,stroke:#0b4884,color:#ffffff,font-size:22px
  classDef contenedor fill:#438dd5,stroke:#2e6295,color:#ffffff,font-size:20px
  classDef componente fill:#85bbf0,stroke:#5d82a8,color:#000000,font-size:20px
  classDef externo fill:#8a8a8a,stroke:#6b6b6b,color:#ffffff,font-size:20px
  class usuario persona
  class web,desktop,gateway,historia,diagnostico,centros,remision,casos,fhir,dbCentros,bus,dbCasos contenedor
  class idp,motor,mapas,acs externo
  style plataforma fill:#ffffff,stroke:#444444,stroke-dasharray:6 4
