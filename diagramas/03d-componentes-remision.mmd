---
title: Diagrama de Componentes - Servicio de Remisión y Notificación (HU04)
---
flowchart TB
  gateway["<b>API Gateway</b><br/><i>[Azure API Management]</i>"]

  subgraph svc["Servicio de Remisión y Notificación [Contenedor: Node.js, NestJS]"]
    direction TB
    controlador["<b>Controlador de Remisiones</b><br/><i>[Componente: REST Controller]</i><br/>POST /remisiones<br/>GET /remisiones/{id}"]
    servicio["<b>Servicio de Remisión</b><br/><i>[Componente: Service]</i><br/>Valida y registra la remisión"]
    repo["<b>Repositorio de Remisiones</b><br/><i>[Componente: TypeORM]</i>"]
    publicador["<b>Publicador de Eventos</b><br/><i>[Componente]</i><br/>Evento RemisionCreada"]
    worker["<b>Procesador de Notificaciones</b><br/><i>[Componente: Worker]</i><br/>Elige canal según el centro<br/>y confirma la recepción"]
    plantillas["<b>Plantillas de Mensaje</b><br/><i>[Componente]</i><br/>Datos mínimos del paciente,<br/>motivo y hora estimada de llegada"]
    reintentos["<b>Gestor de Reintentos</b><br/><i>[Componente]</i><br/>Reintento exponencial<br/>y cola de mensajes fallidos"]
  end

  db[("<b>BD Casos</b><br/><i>[PostgreSQL]</i>")]
  bus[["<b>Bus de Eventos</b><br/><i>[Azure Service Bus]</i>"]]
  acs["<b>Servicio de Comunicaciones</b><br/><i>[Azure Communication Services]</i>"]
  centros["<b>Centro Médico</b><br/><i>[Sistema externo]</i>"]

  gateway -- "HTTPS + JWT" --> controlador
  controlador --> servicio
  servicio --> repo
  servicio --> publicador
  repo --> db
  publicador -- "Publica" --> bus
  bus -- "Consume" --> worker
  worker --> plantillas
  worker --> reintentos
  worker -- "Llamada / SMS / Email" --> acs
  acs -- "Aviso de llegada" --> centros

  classDef componente fill:#85bbf0,stroke:#5d82a8,color:#000000
